rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailLower() {
      return request.auth.token.email.lower();
    }
    // Mirror data/admins.json — only these emails may publish this-week / rule.
    function isAdmin() {
      return signedIn() && emailLower() in [
        'sblanco2005@gmail.com'
      ];
    }
    // Check-ins: any signed-in allowlisted user can read; writers must match their own email.
    // App-level allowlist still gates who can sign in.
    match /checkins/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.email is string
        && request.resource.data.email == emailLower()
        && request.resource.data.pickId is string
        && request.resource.data.keys().hasAll(['email', 'displayName', 'pickId', 'at']);
      allow delete: if false;
    }
    // Live this-week pick + admin rule (source of truth for beta friends).
    // Hosting data/*.json remains bootstrap/fallback only.
    match /config/thisWeek {
      allow read: if signedIn();
      // LIVE only: admin writes must include a real youtubeId. Staging without
      // video belongs in config/nextWeek — rules reject no-video thisWeek writes.
      allow create, update: if isAdmin()
        && request.resource.data.youtubeId is string
        && request.resource.data.youtubeId.size() >= 11;
      allow delete: if false;
    }
    // Staged next-week candidate (admin only). Not shown to members as live.
    match /config/nextWeek {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /config/rule {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
