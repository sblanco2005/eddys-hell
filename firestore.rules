rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailLower() {
      return request.auth.token.email.lower();
    }
    // Mirror data/admins.json — only these emails may publish this-week / rule.
    function isAdmin() {
      return signedIn() && emailLower() in [
        'sblanco2005@gmail.com'
      ];
    }
    // Check-ins: any signed-in allowlisted user can read; writers must match their own email.
    // App-level allowlist still gates who can sign in.
    match /checkins/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.email is string
        && request.resource.data.email == emailLower()
        && request.resource.data.pickId is string
        && request.resource.data.keys().hasAll(['email', 'displayName', 'pickId', 'at']);
      allow delete: if false;
    }
    // Live this-week pick + admin rule (source of truth for beta friends).
    // Hosting data/*.json remains bootstrap/fallback only.
    match /config/thisWeek {
      allow read: if signedIn();
      // LIVE only: admin writes must include a real youtubeId. Staging without
      // video belongs in config/nextWeek — rules reject no-video thisWeek writes.
      allow create, update: if isAdmin()
        && request.resource.data.youtubeId is string
        && request.resource.data.youtubeId.size() >= 11;
      allow delete: if false;
    }
    // Staged next-week candidate (admin only). Not shown to members as live.
    match /config/nextWeek {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /config/rule {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    // Admin ops activity log (compress/stage/swap/skip). Admin R/W only.
    match /activityLog/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    // Admin push broadcasts (beta). Written only by Cloud Function (Admin SDK).
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Broadcast rate-limit lock — server only.
    match /broadcastMeta/{id} {
      allow read, write: if false;
    }
    // Compress/upload job queue (Mac poller). Admin R/W — same gate as config writes.
    match /jobs/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }


    // Member-facing check-in notification feed (this week).
    // Writers may only create/update their own email’s docs; all signed-in can read.
    match /checkinFeed/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.email is string
        && request.resource.data.email == emailLower()
        && request.resource.data.pickId is string
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['email', 'displayName', 'pickId', 'at', 'uid', 'difficulty']);
      allow delete: if false;
    }
    // Per-user prefs (e.g. check-in feed lastSeenAt). Own uid only.
    match /userPrefs/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }


    // Web Push subscriptions (beta). Own uid R/W; signed-in read so a trusted
    // sender/poller (or future Cloud Function Admin SDK) can notify others.
    // Endpoints are semi-sensitive — members-only allowlist app already gates access.
    match /pushSubscriptions/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == emailLower()
        && request.resource.data.endpoint is string
        && request.resource.data.keys is map
        && request.resource.data.enabled is bool
        && request.resource.data.keys().hasAll(['uid', 'email', 'endpoint', 'keys', 'enabled', 'updatedAt']);
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }


    // Mine / Gym (ported Steal builder): private per-user data. Own uid only —
    // nobody else (admins included) can read or write it.
    match /users/{uid} {
      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }
      match /gym/{docId} {
        allow read, write: if isOwner();
      }
      match /workouts/{workoutId} {
        allow read, write: if isOwner();
      }
      match /sessions/{sessionId} {
        allow read, write: if isOwner();
      }
      // Log after photos (p15): base64 JPEG ≤ ~900 KB, owner only; read by scripts/log-parse.mjs (admin creds).
      match /logPhotos/{sessionId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() < 1000000;
      }
      // Coach notes from Arni (written by scripts/coach-note.mjs with admin creds).
      // Owner can read and may only stamp readAt; no client create/delete.
      match /coachNotes/{noteId} {
        allow read: if isOwner();
        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow create, delete: if false;
      }
    }

    // Trainer hand-off queue (beta). A user may enqueue only their own finished
    // session; the box script (admin creds) reads and marks items sent/failed.
    match /trainerQueue/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update: if isAdmin();
      allow delete: if false;
    }


  }
}